  <diagram id="page-class" name="04 Class Diagram">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t-4" value="DIAGRAM KELAS: STRUKTUR DATA TRANSAKSIONAL BANK MINI SEKOLAH v2.2" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="1150" height="36" as="geometry" />
        </mxCell>
        <mxCell id="cls-user" value="&lt;b&gt;User&lt;/b&gt;&lt;hr/&gt;- id: BigInt (PK)&lt;br/&gt;- full_name: String&lt;br/&gt;- username: String (UK)&lt;br/&gt;- email: String (UK)&lt;br/&gt;- password: String (hash)&lt;br/&gt;- role: Enum['admin', 'teller']&lt;br/&gt;- status: Enum['active', 'blocked']&lt;hr/&gt;+ authenticate()&lt;br/&gt;+ updatePassword()&lt;br/&gt;+ hasRole(role)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cls-member" value="&lt;b&gt;Member&lt;/b&gt;&lt;hr/&gt;- nis: String (PK)&lt;br/&gt;- full_name: String&lt;br/&gt;- class_name: String&lt;br/&gt;- graduation_year: String&lt;br/&gt;- status: Enum['active', 'graduated']&lt;hr/&gt;+ promoteClass()&lt;br/&gt;+ graduate()" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="230" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cls-saver" value="&lt;b&gt;Saver&lt;/b&gt;&lt;hr/&gt;- id: BigInt (PK)&lt;br/&gt;- student_number: String (UK)&lt;br/&gt;- member_id: BigInt (FK)&lt;br/&gt;- full_name: String&lt;br/&gt;- pin_hash: String&lt;br/&gt;- password_hash: String&lt;br/&gt;- qr_code_value: String (UK)&lt;br/&gt;- status: Enum['active', 'blocked', 'graduated']&lt;br/&gt;- failed_pin_attempts: Int&lt;hr/&gt;+ verifyPin(pin)&lt;br/&gt;+ verifyPassword(pass)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="650" y="80" width="260" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cls-account" value="&lt;b&gt;Account&lt;/b&gt;&lt;hr/&gt;- id: BigInt (PK)&lt;br/&gt;- customer_id: BigInt (FK)&lt;br/&gt;- account_number: String (UK)&lt;br/&gt;- balance: BigInt&lt;br/&gt;- minimum_balance: BigInt (10000)&lt;br/&gt;- status: Enum['active', 'closed']&lt;hr/&gt;+ hasSufficientBalance(amount)&lt;br/&gt;+ deposit(amount)&lt;br/&gt;+ withdraw(amount)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="970" y="80" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cls-tx" value="&lt;b&gt;Transaction&lt;/b&gt;&lt;hr/&gt;- id: BigInt (PK)&lt;br/&gt;- receipt_number: String (UK)&lt;br/&gt;- slip_number: String&lt;br/&gt;- account_id: BigInt (FK)&lt;br/&gt;- teller_id: BigInt (FK)&lt;br/&gt;- type: Enum['deposit', 'withdrawal', 'transfer', 'reversal']&lt;br/&gt;- amount: BigInt&lt;br/&gt;- balance_before: BigInt&lt;br/&gt;- balance_after: BigInt&lt;br/&gt;- status: Enum['success', 'reversed']&lt;br/&gt;- reversal_of_transaction_id: BigInt (FK)&lt;hr/&gt;+ processAtomic()&lt;br/&gt;+ generateReceipt()&lt;br/&gt;+ reverse(admin_id, reason)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="650" y="360" width="260" height="240" as="geometry" />
        </mxCell>
        <mxCell id="cls-cashreq" value="&lt;b&gt;CashRequest&lt;/b&gt;&lt;hr/&gt;- id: BigInt (PK)&lt;br/&gt;- request_number: String (UK)&lt;br/&gt;- teller_id: BigInt (FK)&lt;br/&gt;- amount: BigInt&lt;br/&gt;- status: Enum['pending', 'approved', 'rejected']&lt;br/&gt;- approved_by: BigInt (FK)&lt;br/&gt;- decision_notes: String&lt;hr/&gt;+ approve(admin_id, notes)&lt;br/&gt;+ reject(admin_id, notes)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1">
