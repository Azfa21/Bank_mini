<mxfile host="app.diagrams.net" agent="Bank Mini Sekolah" version="24.7.17" type="device"><diagram id="page-legend" name="00 Legenda"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Legenda Notasi Use Case — Bank Mini Sekolah" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="st-2" value="Notasi UML 2.5. Kode UC-xx pada diagram sama dengan kode pada dokumen task/use-case-bank-mini.md." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="68" width="1300" height="24" as="geometry"/></mxCell><mxCell id="la1-3" value="Aktor" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="110" y="140" width="40" height="80" as="geometry"/></mxCell><mxCell id="luc1-4" value="Nama Use Case" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="360" y="148" width="240" height="64" as="geometry"/></mxCell><mxCell id="le1-5" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="la1-3" target="luc1-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lt1-6" value="&lt;b&gt;Aktor&lt;/b&gt;&lt;br&gt;Pengguna atau sistem luar yang berinteraksi dengan sistem. Aktor digambar di luar batas sistem.&lt;br&gt;&lt;br&gt;&lt;b&gt;Asosiasi&lt;/b&gt;&lt;br&gt;Garis penghubung antara aktor dan use case yang dijalankannya." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="720" height="120" as="geometry"/></mxCell><mxCell id="incA-7" value="Use Case A" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="120" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="incB-8" value="Use Case B" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="430" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="incE-9" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="incA-7" target="incB-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lt2-10" value="&lt;b&gt;«include»&lt;/b&gt;&lt;br&gt;Use case sumber selalu menjalankan use case tujuan.&lt;br&gt;Contoh: &lt;i&gt;Mengatur Ulang Password&lt;/i&gt; selalu menjalankan &lt;i&gt;Meminta Kode Verifikasi&lt;/i&gt;." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="700" y="290" width="720" height="100" as="geometry"/></mxCell><mxCell id="extA-11" value="Use Case A" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="120" y="430" width="220" height="60" as="geometry"/></mxCell><mxCell id="extB-12" value="Use Case B" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="430" y="430" width="220" height="60" as="geometry"/></mxCell><mxCell id="extE-13" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="extB-12" target="extA-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lt3-14" value="&lt;b&gt;«extend»&lt;/b&gt;&lt;br&gt;Use case sumber hanya berjalan pada kondisi tertentu dan menambah perilaku use case tujuan.&lt;br&gt;Contoh: &lt;i&gt;Mencetak Struk Transaksi&lt;/i&gt; memperluas transaksi yang sudah tersimpan." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="720" height="100" as="geometry"/></mxCell><mxCell id="lb-15" value="Batas Sistem (Bank Mini Sekolah)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#334155;verticalAlign=top;align=center;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="90" y="550" width="560" height="180" as="geometry"/></mxCell><mxCell id="luc2-16" value="Use Case" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="180" y="610" width="300" height="64" as="geometry"/></mxCell><mxCell id="lt4-17" value="&lt;b&gt;Batas sistem&lt;/b&gt;&lt;br&gt;Kotak yang memisahkan tanggung jawab sistem dari aktor. Semua use case berada di dalam kotak; aktor berada di luar." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="700" y="560" width="720" height="100" as="geometry"/></mxCell><mxCell id="lnote-18" value="&lt;b&gt;Cara memakai dan mengubah diagram&lt;/b&gt;&lt;br&gt;1. Buka berkas .drawio di app.diagrams.net atau aplikasi draw.io desktop.&lt;br&gt;2. Setiap tab adalah satu diagram; tab 01–08 memecah sistem per modul agar tetap terbaca.&lt;br&gt;3. Ekspor gambar: File → Export as → PNG atau SVG.&lt;br&gt;4. Kode UC-xx adalah kunci: bila nama use case berubah, perbarui juga dokumen spesifikasi." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="90" y="780" width="560" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-auth" name="01 Autentikasi dan Keamanan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="834" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title-19" value="Use Case Diagram — Autentikasi dan Keamanan Akses" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="1300" height="34" as="geometry"/></mxCell><mxCell id="subtitle-20" value="Aktor: Administrator, Teller, Nasabah, dan Layanan Email sebagai sistem luar." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1400" height="24" as="geometry"/></mxCell><mxCell id="boundary-21" value="Bank Mini Sekolah — Autentikasi dan Keamanan Akses" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#334155;verticalAlign=top;align=center;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="180" y="90" width="520" height="690" as="geometry"/></mxCell><mxCell id="pkg-22" value="Autentikasi dan Sesi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="142" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-01" value="&lt;b&gt;UC-01&lt;/b&gt;&lt;br&gt;Masuk ke Aplikasi" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="186" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-02" value="&lt;b&gt;UC-02&lt;/b&gt;&lt;br&gt;Keluar dari Aplikasi" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="280" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-23" value="Pemulihan Kredensial (Lupa Password)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="384" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-03" value="&lt;b&gt;UC-03&lt;/b&gt;&lt;br&gt;Meminta Kode Verifikasi Pemulihan Password" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="428" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-04" value="&lt;b&gt;UC-04&lt;/b&gt;&lt;br&gt;Mengatur Ulang Password" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="522" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-24" value="PIN Transaksi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="626" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-05" value="&lt;b&gt;UC-05&lt;/b&gt;&lt;br&gt;Mengubah PIN Transaksi" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="670" width="400" height="64" as="geometry"/></mxCell><mxCell id="actor-admin" value="Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="40" height="80" as="geometry"/></mxCell><mxCell id="actor-teller" value="Teller" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="40" height="80" as="geometry"/></mxCell><mxCell id="actor-nasabah" value="Nasabah" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="690" width="40" height="80" as="geometry"/></mxCell><mxCell id="actor-email" value="Layanan Email" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="720" y="420" width="40" height="80" as="geometry"/></mxCell><mxCell id="assoc-25" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-26" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-02"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-27" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-28" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-04"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-29" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-30" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-02"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-31" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-32" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-04"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-33" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-nasabah" target="cell-UC-01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-34" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-nasabah" target="cell-UC-02"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-35" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-nasabah" target="cell-UC-03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-36" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-nasabah" target="cell-UC-04"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-37" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-nasabah" target="cell-UC-05"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-38" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="actor-email" target="cell-UC-03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel-39" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="cell-UC-04" target="cell-UC-03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note-40" value="&lt;b&gt;Aturan kode verifikasi&lt;/b&gt;&lt;br&gt;Kode hanya dikirim ke email yang terdaftar pada akun. Berlaku 10 menit, maksimal 5 permintaan per jam, dan 5 kali percobaan verifikasi. Meminta kode baru menghanguskan kode sebelumnya." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="860" y="106" width="600" height="130" as="geometry"/></mxCell><mxCell id="note-41" value="&lt;b&gt;Aturan PIN&lt;/b&gt;&lt;br&gt;PIN transaksi tepat 6 digit dan disimpan sebagai hash. Salah 3 kali berturut-turut mengunci rekening selama 15 menit. Password login dan PIN transaksi adalah dua kredensial terpisah." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="860" y="319.33333333333337" width="600" height="130" as="geometry"/></mxCell><mxCell id="note-42" value="&lt;b&gt;Jejak audit&lt;/b&gt;&lt;br&gt;Masuk berhasil, masuk gagal, akun diblokir, keluar, permintaan kode, dan reset password dicatat pada audit log beserta aktor dan waktu." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="860" y="532.6666666666667" width="600" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-admin-master" name="02 Administrator — Data Induk"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1224" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title-43" value="Use Case Diagram — Administrator: Pengguna, Anggota, dan Penabung" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="1300" height="34" as="geometry"/></mxCell><mxCell id="subtitle-44" value="Seluruh use case pada halaman ini hanya dapat dijalankan oleh Administrator." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1400" height="24" as="geometry"/></mxCell><mxCell id="boundary-45" value="Bank Mini Sekolah — Modul Administrator: Data Induk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#334155;verticalAlign=top;align=center;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="180" y="90" width="520" height="1080" as="geometry"/></mxCell><mxCell id="pkg-46" value="Manajemen Pengguna Internal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="142" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-07" value="&lt;b&gt;UC-07&lt;/b&gt;&lt;br&gt;Mengelola Akun Pengguna Internal" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="186" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-47" value="Manajemen Anggota" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="290" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-08" value="&lt;b&gt;UC-08&lt;/b&gt;&lt;br&gt;Mengelola Data Anggota" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="334" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-09" value="&lt;b&gt;UC-09&lt;/b&gt;&lt;br&gt;Mengimpor Anggota dari Berkas CSV" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="428" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-48" value="Manajemen Penabung" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="532" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-10" value="&lt;b&gt;UC-10&lt;/b&gt;&lt;br&gt;Mengelola Data Penabung" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="576" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-06" value="&lt;b&gt;UC-06&lt;/b&gt;&lt;br&gt;Mereset PIN Penabung" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="670" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-49" value="Rekening dan Kartu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="774" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-11" value="&lt;b&gt;UC-11&lt;/b&gt;&lt;br&gt;Melihat Detail Rekening" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="818" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-12" value="&lt;b&gt;UC-12&lt;/b&gt;&lt;br&gt;Mencetak Kartu Nasabah" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="912" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-50" value="Konfigurasi Sistem" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="1016" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-13" value="&lt;b&gt;UC-13&lt;/b&gt;&lt;br&gt;Mengatur Konfigurasi Sistem" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="1060" width="400" height="64" as="geometry"/></mxCell><mxCell id="actor-admin" value="Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="619" width="40" height="80" as="geometry"/></mxCell><mxCell id="assoc-51" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-07"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-52" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-08"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-53" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-09"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-54" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-55" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-06"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-56" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-57" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-58" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel-59" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="cell-UC-09" target="cell-UC-08"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel-60" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cell-UC-10" target="cell-UC-06"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note-61" value="&lt;b&gt;Pengguna internal&lt;/b&gt;&lt;br&gt;Role yang tersedia hanya admin dan teller. Sistem menolak penghapusan akun sendiri, akun yang masih memiliki data terkait, serta perubahan yang menyisakan nol Admin atau nol Teller aktif. Reset password wajib disertai alasan." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="106" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-62" value="&lt;b&gt;Anggota&lt;/b&gt;&lt;br&gt;NIS dan email unik. NIS tidak dapat diubah bila anggota sudah memiliki rekening. Anggota yang punya histori rekening tidak dapat dihapus. Impor CSV menambah anggota baru dan memperbarui kelas anggota lama." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="363.5" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-63" value="&lt;b&gt;Penabung&lt;/b&gt;&lt;br&gt;Data alumni dikunci: profil dan statusnya tidak dapat diubah. Pemulihan PIN oleh Administrator wajib disertai alasan dan tercatat pada audit log. Pemblokiran menutup akses masuk, tetapi data tidak dihapus." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="621" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-64" value="&lt;b&gt;Konfigurasi&lt;/b&gt;&lt;br&gt;Nama bank, saldo mengendap minimum, setoran minimal aktivasi, dan daftar kelas/jurusan. Saldo mengendap dipakai bersama aturan penarikan dan penutupan rekening." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="878.5" width="740" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-teller-open" name="03 Teller — Identifikasi dan Pembukaan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="982" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title-65" value="Use Case Diagram — Teller: Identifikasi dan Pembukaan Rekening" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="1300" height="34" as="geometry"/></mxCell><mxCell id="subtitle-66" value="Setoran perdana ikut ditampilkan karena aktivasi rekening selalu memuat setoran." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1400" height="24" as="geometry"/></mxCell><mxCell id="boundary-67" value="Bank Mini Sekolah — Modul Teller: Identifikasi dan Pembukaan Rekening" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#334155;verticalAlign=top;align=center;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="180" y="90" width="520" height="838" as="geometry"/></mxCell><mxCell id="pkg-68" value="Identifikasi Nasabah" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="142" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-14" value="&lt;b&gt;UC-14&lt;/b&gt;&lt;br&gt;Mencari Data Nasabah" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="186" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-15" value="&lt;b&gt;UC-15&lt;/b&gt;&lt;br&gt;Memindai QR Code Kartu Nasabah" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="280" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-69" value="Registrasi dan Aktivasi Rekening" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="384" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-16" value="&lt;b&gt;UC-16&lt;/b&gt;&lt;br&gt;Mendaftarkan Anggota Baru" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="428" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-17" value="&lt;b&gt;UC-17&lt;/b&gt;&lt;br&gt;Mengaktifkan Rekening Anggota" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="522" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-70" value="Transaksi Setoran" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="626" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-19" value="&lt;b&gt;UC-19&lt;/b&gt;&lt;br&gt;Mencatat Setoran Tunai" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="670" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-71" value="Ringkasan Loket" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="774" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-18" value="&lt;b&gt;UC-18&lt;/b&gt;&lt;br&gt;Melihat Ringkasan Loket Harian" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="818" width="400" height="64" as="geometry"/></mxCell><mxCell id="actor-teller" value="Teller" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="40" height="80" as="geometry"/></mxCell><mxCell id="assoc-72" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-73" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-74" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-75" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-76" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-77" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel-78" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="cell-UC-15" target="cell-UC-14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel-79" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cell-UC-17" target="cell-UC-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note-80" value="&lt;b&gt;Pencarian&lt;/b&gt;&lt;br&gt;Kata kunci dapat berupa nomor rekening, NIS, atau nama lengkap. Pemindaian QR hanya cara lain mengisi kata kunci, bukan jalur berbeda." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="106" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-81" value="&lt;b&gt;Aktivasi rekening&lt;/b&gt;&lt;br&gt;Wajib memuat setoran awal minimal sesuai konfigurasi, PIN 6 digit, password aplikasi minimal 8 karakter, dan email unik untuk pemulihan. Nomor rekening dibentuk otomatis dari tahun ajaran dan nomor urut." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="303" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-82" value="&lt;b&gt;Penjagaan transaksi&lt;/b&gt;&lt;br&gt;Semua transaksi ditolak bila rekening tidak aktif, penabung diblokir atau alumni, atau laporan kas teller untuk tanggal tersebut sudah disubmit/disetujui." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="500" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-83" value="&lt;b&gt;Satu transaksi basis data&lt;/b&gt;&lt;br&gt;Setoran, perubahan saldo, dan jurnal akuntansi disimpan bersama. Bila jurnal tidak seimbang, seluruh proses dibatalkan." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="697" width="740" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-teller-trx" name="04 Teller — Transaksi dan Penutupan Kas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1076" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title-84" value="Use Case Diagram — Teller: Transaksi dan Penutupan Kas" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="1300" height="34" as="geometry"/></mxCell><mxCell id="subtitle-85" value="Mencakup penarikan, transfer, bukti transaksi, penutupan rekening, dan laporan kas harian." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1400" height="24" as="geometry"/></mxCell><mxCell id="boundary-86" value="Bank Mini Sekolah — Modul Teller: Transaksi dan Penutupan Kas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#334155;verticalAlign=top;align=center;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="180" y="90" width="520" height="932" as="geometry"/></mxCell><mxCell id="pkg-87" value="Transaksi Loket" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="142" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-20" value="&lt;b&gt;UC-20&lt;/b&gt;&lt;br&gt;Mencatat Penarikan Tunai" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="186" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-21" value="&lt;b&gt;UC-21&lt;/b&gt;&lt;br&gt;Mencatat Transfer Antar Rekening" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="280" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-88" value="Bukti dan Buku Tabungan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="384" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-22" value="&lt;b&gt;UC-22&lt;/b&gt;&lt;br&gt;Mencetak Struk Transaksi" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="428" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-23" value="&lt;b&gt;UC-23&lt;/b&gt;&lt;br&gt;Mencetak Buku Tabungan" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="522" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-89" value="Penutupan Rekening" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="626" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-24" value="&lt;b&gt;UC-24&lt;/b&gt;&lt;br&gt;Mengajukan Penutupan Rekening" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="670" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-90" value="Penutupan Kas Harian" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="774" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-25" value="&lt;b&gt;UC-25&lt;/b&gt;&lt;br&gt;Membuat Laporan Kas Harian" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="818" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-26" value="&lt;b&gt;UC-26&lt;/b&gt;&lt;br&gt;Mencetak Laporan Kas Harian" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="912" width="400" height="64" as="geometry"/></mxCell><mxCell id="actor-teller" value="Teller" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="541" width="40" height="80" as="geometry"/></mxCell><mxCell id="assoc-91" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-92" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-93" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-94" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-95" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-96" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-97" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-teller" target="cell-UC-26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel-98" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="cell-UC-26" target="cell-UC-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note-99" value="&lt;b&gt;Penarikan dan transfer&lt;/b&gt;&lt;br&gt;Memerlukan PIN penabung. Nominal tidak boleh melebihi saldo dan saldo akhir tidak boleh di bawah saldo mengendap — dipakai nilai yang lebih ketat antara saldo rekening dan konfigurasi." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="106" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-100" value="&lt;b&gt;Jurnal otomatis&lt;/b&gt;&lt;br&gt;Setoran: Debet 101 Kas Teller, Kredit 201 Tabungan. Penarikan: kebalikannya. Transfer: Debet 201 pengirim, Kredit 201 penerima." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="326.5" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-101" value="&lt;b&gt;Penutupan rekening&lt;/b&gt;&lt;br&gt;Hanya saldo di atas saldo mengendap yang dicairkan di loket; sisanya tetap tersimpan. Permintaan menunggu keputusan Administrator dan menahan transaksi baru pada rekening tersebut." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="547" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-102" value="&lt;b&gt;Laporan kas&lt;/b&gt;&lt;br&gt;Rekap sistem memuat saldo awal laci, total setoran, total penarikan, dan saldo akhir sistem. Laporan terbit berstatus menunggu validasi; setelah disubmit, transaksi baru pada tanggal itu ditolak." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="767.5" width="740" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-admin-cash" name="05 Administrator — Otorisasi Kas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="834" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title-103" value="Use Case Diagram — Administrator: Otorisasi Kas dan Koreksi" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="1300" height="34" as="geometry"/></mxCell><mxCell id="subtitle-104" value="Pemisahan tugas: Administrator yang menyetujui tidak boleh pembuat laporan." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1400" height="24" as="geometry"/></mxCell><mxCell id="boundary-105" value="Bank Mini Sekolah — Modul Administrator: Otorisasi Kas dan Koreksi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#334155;verticalAlign=top;align=center;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="180" y="90" width="520" height="690" as="geometry"/></mxCell><mxCell id="pkg-106" value="Validasi Laporan Harian" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="142" width="440" height="316" as="geometry"/></mxCell><mxCell id="cell-UC-27" value="&lt;b&gt;UC-27&lt;/b&gt;&lt;br&gt;Memeriksa Laporan Kas Harian" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="186" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-28" value="&lt;b&gt;UC-28&lt;/b&gt;&lt;br&gt;Menyetujui Laporan Kas Harian" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="280" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-30" value="&lt;b&gt;UC-30&lt;/b&gt;&lt;br&gt;Menolak Laporan Kas Harian" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="374" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-107" value="Pemindahan Kas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="478" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-29" value="&lt;b&gt;UC-29&lt;/b&gt;&lt;br&gt;Memindahkan Kas ke Brankas Utama" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="522" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-108" value="Koreksi Transaksi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="626" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-31" value="&lt;b&gt;UC-31&lt;/b&gt;&lt;br&gt;Mengoreksi Transaksi" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="670" width="400" height="64" as="geometry"/></mxCell><mxCell id="actor-admin" value="Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="374" width="40" height="80" as="geometry"/></mxCell><mxCell id="assoc-109" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-110" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-111" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-112" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel-113" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cell-UC-28" target="cell-UC-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note-114" value="&lt;b&gt;Syarat approval&lt;/b&gt;&lt;br&gt;Hanya laporan berstatus menunggu validasi, oleh Administrator yang bukan pembuat laporan, dan hanya bila saldo akhir sistem belum berubah sejak laporan dibuat." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="106" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-115" value="&lt;b&gt;Pemindahan kas&lt;/b&gt;&lt;br&gt;Approval menyapu seluruh kas laci ke Brankas Utama dan memposting jurnal Debet 102 Kas Brankas, Kredit 101 Kas Teller. Pemindahan ditolak bila nominal melebihi saldo kas laci menurut jurnal." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="266" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-116" value="&lt;b&gt;Penolakan&lt;/b&gt;&lt;br&gt;Wajib bercatatan. Teller dapat memperbaiki dan mengirim ulang laporan dengan nomor laporan yang sama." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="426" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-117" value="&lt;b&gt;Koreksi&lt;/b&gt;&lt;br&gt;Memakai jurnal pembalik; transaksi asal ditandai reversed, bukan diubah. Koreksi ditolak bila laporan harian tanggal tersebut sudah disetujui karena kas sudah berpindah ke brankas." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="586" width="740" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-admin-report" name="06 Administrator — Akuntansi dan Laporan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1036" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title-118" value="Use Case Diagram — Administrator: Akuntansi dan Laporan" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="1300" height="34" as="geometry"/></mxCell><mxCell id="subtitle-119" value="Seluruh laporan bersifat baca-saja dan hanya terbuka untuk Administrator." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1400" height="24" as="geometry"/></mxCell><mxCell id="boundary-120" value="Bank Mini Sekolah — Modul Administrator: Akuntansi dan Laporan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#334155;verticalAlign=top;align=center;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="180" y="90" width="520" height="892" as="geometry"/></mxCell><mxCell id="pkg-121" value="Audit Jurnal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="142" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-32" value="&lt;b&gt;UC-32&lt;/b&gt;&lt;br&gt;Melihat Jurnal Akuntansi" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="186" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-122" value="Buku Besar dan Neraca Saldo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="290" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-33" value="&lt;b&gt;UC-33&lt;/b&gt;&lt;br&gt;Melihat Buku Besar dan Neraca Saldo" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="334" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-123" value="Ekspor Laporan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="438" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-34" value="&lt;b&gt;UC-34&lt;/b&gt;&lt;br&gt;Mengekspor Laporan Akuntansi" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="482" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-124" value="Laporan Bulanan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="586" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-35" value="&lt;b&gt;UC-35&lt;/b&gt;&lt;br&gt;Melihat Laporan Bulanan" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="630" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-36" value="&lt;b&gt;UC-36&lt;/b&gt;&lt;br&gt;Mencetak Laporan Bulanan" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="724" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-125" value="Dasbor Analitik" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="828" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-37" value="&lt;b&gt;UC-37&lt;/b&gt;&lt;br&gt;Melihat Dasbor Analitik" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="872" width="400" height="64" as="geometry"/></mxCell><mxCell id="actor-admin" value="Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="534" width="40" height="80" as="geometry"/></mxCell><mxCell id="assoc-126" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-127" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-128" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-129" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-130" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-131" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel-132" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="cell-UC-34" target="cell-UC-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note-133" value="&lt;b&gt;Hak akses&lt;/b&gt;&lt;br&gt;Jurnal, buku besar, neraca saldo, dan ekspor hanya untuk Administrator. Teller dan Nasabah ditolak oleh policy." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="106" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-134" value="&lt;b&gt;Akun yang ditampilkan&lt;/b&gt;&lt;br&gt;Akun 201 Tabungan Nasabah tetap diposting agar buku seimbang, tetapi tidak ditampilkan pada layar maupun berkas ekspor staf. Hanya 101 dan 102 yang tampil." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="316.5" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-135" value="&lt;b&gt;Ekspor CSV&lt;/b&gt;&lt;br&gt;Mengikuti filter halaman (akun dan rentang tanggal) dan memakai UTF-8 BOM agar terbaca di Excel. Jenis berkas: jurnal, buku besar, dan neraca saldo." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="527" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-136" value="&lt;b&gt;Indikator keseimbangan&lt;/b&gt;&lt;br&gt;Status seimbang dihitung dari seluruh akun, termasuk akun yang tidak ditampilkan, sehingga angka tidak pernah menyesatkan." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="737.5" width="740" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-admin-academic" name="07 Administrator — Kelulusan dan Kenaikan Kelas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1076" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title-137" value="Use Case Diagram — Administrator: Kelulusan dan Kenaikan Kelas" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="1300" height="34" as="geometry"/></mxCell><mxCell id="subtitle-138" value="Administrasi akademik yang berdampak pada status rekening dan akses masuk nasabah." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1400" height="24" as="geometry"/></mxCell><mxCell id="boundary-139" value="Bank Mini Sekolah — Modul Administrator: Administrasi Akademik" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#334155;verticalAlign=top;align=center;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="180" y="90" width="520" height="932" as="geometry"/></mxCell><mxCell id="pkg-140" value="Kenaikan Kelas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="142" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-38" value="&lt;b&gt;UC-38&lt;/b&gt;&lt;br&gt;Memproses Kenaikan Kelas" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="186" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-141" value="Kelulusan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="290" width="440" height="316" as="geometry"/></mxCell><mxCell id="cell-UC-39" value="&lt;b&gt;UC-39&lt;/b&gt;&lt;br&gt;Memproses Kelulusan Angkatan" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="334" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-40" value="&lt;b&gt;UC-40&lt;/b&gt;&lt;br&gt;Menandai Anggota Lulus" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="428" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-41" value="&lt;b&gt;UC-41&lt;/b&gt;&lt;br&gt;Menandai Anggota Tidak Lulus" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="522" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-142" value="Penutupan Rekening Alumni" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="626" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-42" value="&lt;b&gt;UC-42&lt;/b&gt;&lt;br&gt;Menyetujui Permintaan Penutupan Rekening" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="670" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-43" value="&lt;b&gt;UC-43&lt;/b&gt;&lt;br&gt;Menolak Permintaan Penutupan Rekening" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="764" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-143" value="Arsip Kelulusan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="868" width="440" height="128" as="geometry"/></mxCell><mxCell id="cell-UC-44" value="&lt;b&gt;UC-44&lt;/b&gt;&lt;br&gt;Mengunduh Arsip Kelulusan" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="912" width="400" height="64" as="geometry"/></mxCell><mxCell id="actor-admin" value="Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="541" width="40" height="80" as="geometry"/></mxCell><mxCell id="assoc-144" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-145" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-146" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-147" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-148" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-149" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-150" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-admin" target="cell-UC-44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel-151" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="cell-UC-44" target="cell-UC-39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note-152" value="&lt;b&gt;Kenaikan kelas&lt;/b&gt;&lt;br&gt;Memproses anggota dan penabung per kelas, mendukung tinggal kelas per kelas atau per siswa, dan menolak pengulangan pada tahun ajaran yang sama tanpa konfirmasi." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="106" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-153" value="&lt;b&gt;Kelulusan&lt;/b&gt;&lt;br&gt;Anggota hanya diarsipkan bila tidak punya rekening atau sisa saldonya tinggal saldo mengendap. Saldo di atasnya harus dicairkan di loket lebih dulu." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="326.5" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-154" value="&lt;b&gt;Tidak lulus&lt;/b&gt;&lt;br&gt;Membatalkan pencairan yang sudah dilakukan lewat jurnal pembalik, lalu menggeser anggota ke angkatan berikutnya agar tidak ikut diproses pada angkatan ini." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="547" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-155" value="&lt;b&gt;Penutupan rekening&lt;/b&gt;&lt;br&gt;Approval menjadikan penabung alumni, menutup rekening, dan menghapus token aplikasi mobile. Penolakan mengembalikan saldo yang sempat dicairkan dan rekening tetap aktif." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="767.5" width="740" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-nasabah" name="08 Nasabah — Layanan Mandiri"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title-156" value="Use Case Diagram — Nasabah: Layanan Mandiri" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="1300" height="34" as="geometry"/></mxCell><mxCell id="subtitle-157" value="Berlaku pada web nasabah dan aplikasi Flutter; masuk, keluar, pemulihan password, dan ganti PIN ada pada halaman 01." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1400" height="24" as="geometry"/></mxCell><mxCell id="boundary-158" value="Bank Mini Sekolah — Layanan Mandiri Nasabah" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#334155;verticalAlign=top;align=center;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="180" y="90" width="520" height="636" as="geometry"/></mxCell><mxCell id="pkg-159" value="Informasi Rekening" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="142" width="440" height="316" as="geometry"/></mxCell><mxCell id="cell-UC-45" value="&lt;b&gt;UC-45&lt;/b&gt;&lt;br&gt;Melihat Saldo dan Ringkasan Rekening" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="186" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-46" value="&lt;b&gt;UC-46&lt;/b&gt;&lt;br&gt;Melihat Riwayat Mutasi" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="280" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-47" value="&lt;b&gt;UC-47&lt;/b&gt;&lt;br&gt;Melihat dan Mengunduh Rekening Koran" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="374" width="400" height="64" as="geometry"/></mxCell><mxCell id="pkg-160" value="Kartu dan Profil" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="220" y="478" width="440" height="222" as="geometry"/></mxCell><mxCell id="cell-UC-48" value="&lt;b&gt;UC-48&lt;/b&gt;&lt;br&gt;Melihat Kartu Nasabah Virtual" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="522" width="400" height="64" as="geometry"/></mxCell><mxCell id="cell-UC-49" value="&lt;b&gt;UC-49&lt;/b&gt;&lt;br&gt;Melihat Profil Nasabah" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="240" y="616" width="400" height="64" as="geometry"/></mxCell><mxCell id="actor-nasabah" value="Nasabah" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="392" width="40" height="80" as="geometry"/></mxCell><mxCell id="assoc-161" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-nasabah" target="cell-UC-45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-162" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-nasabah" target="cell-UC-46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-163" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-nasabah" target="cell-UC-47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-164" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-nasabah" target="cell-UC-48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="assoc-165" value="" style="endArrow=none;html=1;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actor-nasabah" target="cell-UC-49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel-166" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#7c3aed;fontColor=#6d28d9;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="cell-UC-47" target="cell-UC-46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note-167" value="&lt;b&gt;Batasan data&lt;/b&gt;&lt;br&gt;Nasabah hanya dapat membaca rekening miliknya sendiri. Permintaan ke rekening, profil, atau mutasi nasabah lain ditolak." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="106" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-168" value="&lt;b&gt;Riwayat mutasi&lt;/b&gt;&lt;br&gt;Memuat transaksi keluar dan masuk, termasuk transfer, dengan filter jenis transaksi dan rentang tanggal serta pagination." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="252.5" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-169" value="&lt;b&gt;Rekening koran&lt;/b&gt;&lt;br&gt;Mencakup rentang tanggal, ringkasan per jenis transaksi, dan kode verifikasi dokumen. Dapat dicetak atau disimpan sebagai PDF." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="399" width="740" height="110" as="geometry"/></mxCell><mxCell id="note-170" value="&lt;b&gt;Kanal aplikasi&lt;/b&gt;&lt;br&gt;Aplikasi Flutter memakai API token dengan use case yang sama. Halaman profil hanya tersedia di aplikasi mobile; kartu virtual tersedia di web dan mobile." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="730" y="545.5" width="740" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
